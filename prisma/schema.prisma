datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  nama      String
  jabatan   String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Berita {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  category  String
  summary   String   @db.Text
  content   String   @db.Text
  author    String
  date      DateTime @default(now())
  imageUrl  String?  @db.Text
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DokumenHukum {
  id          String   @id @default(uuid())
  nomor       String
  tahun       Int
  judul       String   @db.Text
  kategori    String   // Perdes, Perkades, Keputusan Kades, RPJMDes, APBDes
  deskripsi   String   @db.Text
  fileUrl     String?  @db.Text
  tglTerbit   DateTime
  status      String   @default("Berlaku")
  createdAt   DateTime @default(now())
}

model UMKM {
  id           String   @id @default(uuid())
  namaUsaha    String
  pemilik      String
  kategori     String   // Kuliner, Pertanian, Kerajinan, Jasa
  deskripsi    String   @db.Text
  alamat       String   @db.Text
  kontak       String
  omzetBulanan Float?
  produkUtama  String
  imageUrl     String?  @db.Text
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model KomoditasPertanian {
  id            String   @id @default(uuid())
  nama          String   // Padi, Jagung, Cabai, Sapi
  kategori      String   // Tanaman Pangan, Hortikultura, Peternakan
  luasLahan     Float?   // Hektar
  jumlahTernak  Int?     // Ekor
  estimasiHasil String
  musimTanam    String
  musimPanen    String
  kelompokTani  String
  lokasi        String
  updatedAt     DateTime @updatedAt
}

model ISPARecord {
  id               String   @id @default(uuid())
  nama             String
  usia             Int
  dusun            String
  gejala           String   @db.Text // JSON string of symptoms
  skorRisiko       Int
  kategoriRisiko   String   // Rendah, Sedang, Tinggi
  rekomendasi      String   @db.Text
  createdAt        DateTime @default(now())
}

model APBDesEntry {
  id         String   @id @default(uuid())
  tahun      Int
  kategori   String   // Pendapatan, Belanja, Pembiayaan
  subsektor  String
  anggaran   Float
  realisasi  Float
  keterangan String?  @db.Text
}

model LaporanAntiKorupsi {
  id             String   @id @default(uuid())
  kodeLaporan    String   @unique
  judulLaporan   String   @db.Text
  kategori       String   // Pelayanan Publik, Pungli, Transparansi Anggaran, Lainnya
  deskripsi      String   @db.Text
  lokasiKejadian String
  isAnonim       Boolean  @default(true)
  namaPelapor    String?
  kontakPelapor  String?
  status         String   @default("Diproses") // Diproses, Diverifikasi, Selesai
  createdAt      DateTime @default(now())
}
